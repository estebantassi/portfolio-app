{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:23.6.1 AS build-client",
  
    "WORKDIR /usr/src/client",
    
    "COPY react/package*.json ./",
    
    "RUN npm install",
    
    "COPY react/. ./",

    "RUN npm run build",

    "FROM nginx:alpine",

    "COPY --from=build-client /usr/src/client/dist /usr/share/nginx/html",
    
    "COPY nginx.conf /etc/nginx/conf.d/default.conf",

    "EXPOSE 80",
    
    "CMD [\"nginx\", \"-g\", \"daemon off\"]"
  ]
}